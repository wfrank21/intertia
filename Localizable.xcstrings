    "iOS stellt Apps die Anzahl erfasster GPS-Satelliten aus Datenschutzgründen nicht zur Verfügung. Die Signalqualität wird stattdessen aus der Genauigkeit der Standortmessung abgeleitet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS stellt Apps die Anzahl erfasster GPS-Satelliten aus Datenschutzgründen nicht zur Verfügung. Die Signalqualität wird stattdessen aus der Genauigkeit der Standortmessung abgeleitet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For privacy reasons, iOS does not expose the number of acquired GPS satellites to apps. Signal quality is instead derived from the accuracy of the location reading."
          }
        }
      }
    },
