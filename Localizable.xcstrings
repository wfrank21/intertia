    "Ich habe den Hinweis gelesen und verstanden und werde die StVO sowie alle geltenden Verkehrsvorschriften jederzeit einhalten." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe den Hinweis gelesen und verstanden und werde die StVO sowie alle geltenden Verkehrsvorschriften jederzeit einhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I have read and understood this notice and will comply with the StVO and all applicable traffic regulations at all times."
          }
        }
      }
    },
    "Inertia" : {
