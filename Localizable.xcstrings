    "Niedriger = reagiert empfindlicher auf das Anfahren, kann aber durch Erschütterungen fehlauslösen. Höher = weniger anfällig, erkennt sanftes Anfahren u.U. später." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niedriger = reagiert empfindlicher auf das Anfahren, kann aber durch Erschütterungen fehlauslösen. Höher = weniger anfällig, erkennt sanftes Anfahren u.U. später."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lower = reacts more sensitively to launching, but may trigger falsely from bumps. Higher = less prone to false triggers, but may detect gentle launches later."
          }
        }
      }
    },
